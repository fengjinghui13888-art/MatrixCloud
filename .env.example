PORT=4174
DATA_DIR=./work
PUBLIC_ORIGIN=https://your-workbench.example
MATRIX_CLOUD_URL=https://your-workbench.example
CONNECTOR_PACKAGES_DIR=./connectors
# Set a long random value in production; never commit the real token.
MCP_SERVICE_TOKEN=replace-with-a-long-random-token
MCP_REQUIRE_AUTH=true
# Exact HTTPS origin required for cookie authentication behind a reverse proxy.
# PUBLIC_ORIGIN=https://your-workbench.example

# Docker frontend address; change with compose and frontend/nginx.conf together.
TRUSTED_PROXY_IPS=172.30.83.10
