[Unit]
Description=Matrix Cloud administrator maintenance MCP
After=network.target docker.service
[Service]
Type=simple
User=matrix-maintenance
WorkingDirectory=/opt/matrix-maintenance/runtime
Environment=MAINTENANCE_CONFIG=/etc/matrix-maintenance/config.json
ExecStart=/opt/matrix-maintenance/node/bin/node --import tsx backend/server/maintenance.ts
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
