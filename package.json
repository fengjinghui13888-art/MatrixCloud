{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "name": "xhs-matrix-ops",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "start": "pnpm --dir backend start",
    "build": "pnpm --dir backend build && pnpm --dir frontend build",
    "typecheck": "pnpm --dir backend typecheck && pnpm --dir frontend typecheck",
    "test": "vitest run --maxWorkers=2 --minWorkers=1",
    "test:frontend": "pnpm --dir frontend test",
    "test:backend": "pnpm --dir backend test",
    "test:watch": "vitest",
    "mcp:workbuddy": "node --import tsx backend/server/workbuddy-mcp.ts",
    "executor:studio": "node scripts/studio-executor.mjs",
    "connector": "node local-connector/connector.mjs",
    "preflight": "node scripts/preflight.mjs",
    "release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.63.0",
    "ws": "8.21.3",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1"
  }
}
