# Copy to .env.docker. This file is read only by the Python backend container.
# Replace the placeholder with the restricted application user's password.
DATABASE_URL=postgresql://matrix_app:REPLACE_WITH_APP_PASSWORD@postgres:5432/matrix
DATABASE_REQUIRED=true
LOCAL_POSTGRES=false
PUBLIC_ORIGIN=http://127.0.0.1:8080
# Use the public HTTPS origin for production.
MATRIX_CLOUD_URL=http://127.0.0.1:8080
MCP_REQUIRE_AUTH=true
