HOST=127.0.0.1
PORT=4174
APP_ENV=development
# Relative paths resolve from backend/, including when started elsewhere.
DATA_DIR=./data/work/grey
PUBLIC_ORIGIN=http://127.0.0.1:5173
MATRIX_CLOUD_URL=http://127.0.0.1:5173
MCP_REQUIRE_AUTH=true
# Empty = reuse the existing access-token file or generate one on first start.
MCP_SERVICE_TOKEN=
# Local development only. Production uses exact trusted proxy IPs and HTTPS.
TRUST_LOCAL_PROXY_HTTP=1
TRUST_LOOPBACK_PROXY=1
TRUSTED_PROXY_IPS=
# Leave empty for SQLite. PostgreSQL requires the normalized schema v2 first.
DATABASE_URL=
CONNECTOR_PACKAGES_DIR=./outputs/connectors
MAINTENANCE_CONFIG=
